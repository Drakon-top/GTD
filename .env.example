# Database
DB_NAME=gtd_prod
DB_USERNAME=gtd_user
DB_PASSWORD=change-me-to-strong-password

# RabbitMQ
RABBITMQ_USERNAME=gtd_rabbit
RABBITMQ_PASSWORD=change-me-to-strong-password

# JWT (minimum 256-bit / 32-byte secret for HS256)
JWT_SECRET=change-me-to-random-base64-string-at-least-32-bytes

# CORS (comma-separated origins)
# For IP-only mode: http://YOUR_SERVER_IP
# For domain mode:  https://your-domain.com
CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP

# Domain and SSL (optional — leave commented out for IP-only HTTP mode)
# DOMAIN=your-domain.com
# SSL_EMAIL=admin@your-domain.com

# Firebase Cloud Messaging (optional — set to true and provide credentials file for push notifications)
FCM_ENABLED=false
FCM_CREDENTIALS_FILE=/app/config/firebase-service-account.json

# Ports exposed on host
HTTP_PORT=80
HTTPS_PORT=443
