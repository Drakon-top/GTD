# Database
DB_NAME=gtd_prod
DB_USERNAME=gtd_user
DB_PASSWORD=change-me-to-strong-password

# RabbitMQ
RABBITMQ_USERNAME=gtd_rabbit
RABBITMQ_PASSWORD=change-me-to-strong-password

# JWT (minimum 256-bit / 32-byte secret for HS256)
JWT_SECRET=change-me-to-random-base64-string-at-least-32-bytes

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://your-domain.com

# HTTP port exposed on host
HTTP_PORT=80
